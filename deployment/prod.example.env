# ===================================================================
#      PRODUCTION ENVIRONMENT CONFIGURATION - GOOGLE CLOUD
# -------------------------------------------------------------------
#  Copy this file to .env.prod and customize with your actual values
#  DO NOT commit the actual .env.prod file to version control!
# ===================================================================

# ------------------------------------------------------------
# GOOGLE CLOUD PROJECT CONFIGURATION
# ------------------------------------------------------------
# Your Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Google Cloud Region for deployment
GOOGLE_CLOUD_REGION=us-central1

# Cloud Run Service Names (will be created if they don't exist)
BACKEND_SERVICE_NAME=your-app-backend
FRONTEND_SERVICE_NAME=your-app-frontend

# ------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------
# Environment: MUST be "production" for production deployment
APP_ENV=production

# Base path for reverse proxy (leave empty unless using a custom domain path)
BASE_PATH=

# ------------------------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------------------------
# Frontend URL for CORS (use your actual domain)
FRONTEND_URL=https://your-app-frontend-abc123-uc.a.run.app${BASE_PATH}

# Backend server port (Cloud Run uses PORT from environment)
PORT=8000

# Server IP binding (0.0.0.0 for Cloud Run)
INTERNAL_IP=0.0.0.0

# ------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------
# Public API URL (use your actual backend Cloud Run URL)
NEXT_PUBLIC_API_URL=https://your-app-backend-abc123-uc.a.run.app

# Frontend base path
NEXT_PUBLIC_BASE_PATH=${BASE_PATH}

# Internal API URL (for server-side requests, same as public for Cloud Run)
INTERNAL_API_URL=https://your-app-backend-abc123-uc.a.run.app

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
# Application log level: INFO recommended for production
LOG_LEVEL=INFO

# Gunicorn log level: info recommended for production
GUNICORN_LOG_LEVEL=info

# ------------------------------------------------------------
# DATABASE CONFIGURATION - CLOUD SQL
# ------------------------------------------------------------
# Cloud SQL Instance Connection Name (PROJECT_ID:REGION:INSTANCE_NAME)
CLOUD_SQL_CONNECTION_NAME=your-project-id:us-central1:your-postgres-instance

# Database credentials
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=your-app-db
POSTGRES_HOST=/cloudsql/your-project-id:us-central1:your-postgres-instance
POSTGRES_PORT=5432

# Full database URL for Cloud SQL (using Unix socket)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@/${POSTGRES_DB}?host=/cloudsql/${CLOUD_SQL_CONNECTION_NAME}

# Skip database wait on startup (false for production reliability)
SKIP_DB_WAIT=false

# ------------------------------------------------------------
# PRODUCTION SERVER CONFIGURATION
# ------------------------------------------------------------
# Worker connections per process (Cloud Run handles scaling)
WORKER_CONNECTIONS=1000

# Request timeout (seconds) - Cloud Run max is 3600 (1 hour)
GUNICORN_TIMEOUT=300

# ------------------------------------------------------------
# CLOUD RUN SPECIFIC CONFIGURATION
# ------------------------------------------------------------
# Memory allocation per instance (e.g., 1Gi, 2Gi, 4Gi)
CLOUD_RUN_MEMORY=1Gi

# CPU allocation per instance (1 = 1 vCPU, 2 = 2 vCPU)
CLOUD_RUN_CPU=1

# Maximum number of instances (auto-scaling limit)
CLOUD_RUN_MAX_INSTANCES=10

# Minimum number of instances (0 for serverless, 1+ for always-on)
CLOUD_RUN_MIN_INSTANCES=0

# Request timeout in seconds (max 3600 for Cloud Run)
CLOUD_RUN_TIMEOUT=300

# Maximum concurrent requests per instance
CLOUD_RUN_CONCURRENCY=80

# ------------------------------------------------------------
# SECURITY CONFIGURATION
# ------------------------------------------------------------
# Allow unauthenticated requests (true for public APIs, false for private)
CLOUD_RUN_ALLOW_UNAUTHENTICATED=true

# Custom domain (optional - set up in Cloud Run console after deployment)
# CUSTOM_DOMAIN_BACKEND=api.yourdomain.com
# CUSTOM_DOMAIN_FRONTEND=yourdomain.com

# SSL/TLS configuration (handled automatically by Cloud Run)
# FORCE_HTTPS=true

# ===================================================================
#      OPTIONAL: ADDITIONAL GOOGLE CLOUD SERVICES
# -------------------------------------------------------------------
#  Uncomment and configure as needed for your application
# ===================================================================

# Google Cloud Storage (for file uploads, static assets)
# GCS_BUCKET_NAME=your-app-storage
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Google Cloud Logging (automatic with Cloud Run)
# LOG_SEVERITY=INFO

# Google Cloud Error Reporting (automatic with Cloud Run)
# ERROR_REPORTING_ENABLED=true

# Google Cloud Monitoring/Metrics (automatic with Cloud Run)
# MONITORING_ENABLED=true

# Redis/Memorystore (for caching, sessions)
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# Email/SendGrid (for transactional emails)
# SENDGRID_API_KEY=your-sendgrid-api-key
# FROM_EMAIL=noreply@yourdomain.com

# ===================================================================
#      DEPLOYMENT CONFIGURATION
# -------------------------------------------------------------------
#  Configuration for the deployment script
# ===================================================================

# Docker image registry (Google Container Registry or Artifact Registry)
DOCKER_REGISTRY=gcr.io
# Alternative: DOCKER_REGISTRY=us-central1-docker.pkg.dev

# Image tags for deployment
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# Build timeout (in seconds)
BUILD_TIMEOUT=1200

# Deployment confirmation (set to 'false' to skip confirmation prompts)
REQUIRE_DEPLOYMENT_CONFIRMATION=true
