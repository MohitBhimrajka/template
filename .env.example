# ===================================================================
#      FULL-STACK TEMPLATE - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env and customize as needed.
#  This file contains the complete configuration for development and production.
# ===================================================================

# ------------------------------------------------------------
# GENERAL APPLICATION SETTINGS
# ------------------------------------------------------------
# Environment mode: development, staging, production
# Affects logging format, server behavior, and other settings
APP_ENV=development

# The base path for the entire application, used for reverse proxy routing.
# Example: /myapp -> http://localhost:3001/myapp
# Leave empty if not using a reverse proxy or subpath.
BASE_PATH=

# ------------------------------------------------------------
# BACKEND (FastAPI) CONFIGURATION
# ------------------------------------------------------------
# The full URL of the frontend, used for CORS configuration.
FRONTEND_URL=http://localhost:3001${BASE_PATH}

# Server port for the backend (used in production deployment)
PORT=8000

# Internal IP binding for development server (usually 0.0.0.0 for Docker compatibility)
INTERNAL_IP=0.0.0.0

# ------------------------------------------------------------
# FRONTEND (Next.js) CONFIGURATION
# ------------------------------------------------------------
# The public URL for the backend API that the browser will call.
NEXT_PUBLIC_API_URL=http://localhost:8001

# The base path for the frontend application.
NEXT_PUBLIC_BASE_PATH=${BASE_PATH}

# Internal API URL for server-side requests (container-to-container communication)
INTERNAL_API_URL=http://backend:8000

# ------------------------------------------------------------
# LOGGING & DEBUGGING
# ------------------------------------------------------------
# Set the log level for the backend service.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Gunicorn-specific log level for production deployments
# Options: debug, info, warning, error, critical
GUNICORN_LOG_LEVEL=info

# ------------------------------------------------------------
# DATABASE (PostgreSQL) CONFIGURATION
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# This is the full connection string used by SQLAlchemy
# It is constructed from the variables above.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Skip database connection wait (useful for development when DB is already ready)
# Set to "true" to skip waiting for database connection during startup
SKIP_DB_WAIT=false

# ------------------------------------------------------------
# PRODUCTION SERVER CONFIGURATION
# ------------------------------------------------------------
# Number of Gunicorn worker processes (production only)
# Usually set to (2 x CPU cores) + 1, or use WEB_CONCURRENCY from your hosting platform
# Uncomment and set for production deployments
# WEB_CONCURRENCY=1

# Maximum number of simultaneous connections per worker
WORKER_CONNECTIONS=1000

# Request timeout in seconds (how long to wait for slow requests)
GUNICORN_TIMEOUT=120

# ===================================================================
#      SECURITY & AUTHENTICATION (For Future Implementation)
# -------------------------------------------------------------------
#  The current template has authentication removed for simplicity.
#  Add these when implementing your own auth system.
# ===================================================================

# JWT/Session secrets (generate strong random secrets for production)
# SECRET_KEY=your_secret_key_here
# JWT_SECRET_KEY=your_jwt_secret_here
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_TIME=3600

# NextAuth.js configuration (if using NextAuth)
# NEXTAUTH_SECRET=your_nextauth_secret_here
# NEXTAUTH_URL=http://localhost:3001

# OAuth providers (examples - configure as needed)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# ===================================================================
#      EXTERNAL SERVICES (For Future Integration)
# -------------------------------------------------------------------
#  Add configuration for external APIs and services as needed.
# ===================================================================

# Email service (e.g., SendGrid, Mailgun, SMTP)
# EMAIL_FROM=noreply@yourapp.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_email_password

# File storage (e.g., AWS S3, Google Cloud Storage)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your_bucket_name

# Redis (for caching, sessions, queues)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

# Monitoring and Analytics
# SENTRY_DSN=https://your_sentry_dsn
# GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# ===================================================================
#      CUSTOM CONFIGURATION
# -------------------------------------------------------------------
#  Add your own application-specific environment variables here.
# ===================================================================

# Feature flags
# FEATURE_ENABLE_PREMIUM=false
# FEATURE_ENABLE_ANALYTICS=true

# Rate limiting
# RATE_LIMIT_REQUESTS_PER_MINUTE=100
# RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Add your custom environment variables here
# CUSTOM_API_KEY=your_api_key_here
# THIRD_PARTY_SERVICE_URL=https://api.example.com
