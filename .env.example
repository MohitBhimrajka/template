# ===================================================================
#      FULL-STACK TEMPLATE - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env and customize as needed.
# ===================================================================

# ------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------
# Environment: development or production
APP_ENV=development

# Base path for reverse proxy (leave empty if not using)
BASE_PATH=

# ------------------------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------------------------
# Frontend URL for CORS
FRONTEND_URL=http://localhost:3001${BASE_PATH}

# Backend server port (Docker Compose handles frontend port separately)
# NOTE: Frontend always uses port 3000 inside container, mapped to host 3001
PORT=8000

# Server IP binding (0.0.0.0 for Docker)
INTERNAL_IP=0.0.0.0

# ------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------
# Public API URL (called by browser)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Frontend base path
NEXT_PUBLIC_BASE_PATH=${BASE_PATH}

# Internal API URL (server-side requests)
INTERNAL_API_URL=http://backend:8000

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Gunicorn log level: debug, info, warning, error, critical
GUNICORN_LOG_LEVEL=info

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Skip database wait on startup (true/false)
SKIP_DB_WAIT=false

# ------------------------------------------------------------
# PRODUCTION SERVER
# ------------------------------------------------------------
# Worker connections per process
WORKER_CONNECTIONS=1000

# Request timeout (seconds)
GUNICORN_TIMEOUT=120
